#!/bin/bash
# zzz — push an event to the zzz.notch notch.
#
#   zzz notify "title" ["body"] [--status info|ok|fail|wait|run|idle] [--source NAME]
#              [--symbol SF_SYMBOL] [--app BUNDLE_ID] [--url URL] [--id KEY]
#              [--duration SECONDS] [--detail "current step"]
#              [--activity type|search|build|push|read] [--agents N] [--prompt "text"]
#              [--now "headline"] [--intent "why"] [--command "raw command"] [--step "plan position"]
#              [--agent-list "name · task" (one subagent per line)]
#   zzz clear --id KEY
#   zzz ask "question" --id KEY --option A [--option B ...] [--multiple] [--timeout S]
#              waits for an answer in the notch and prints the chosen option(s), one per line.
#              Exit 1 if nothing was answered in time or the app is not running.
#
# run/wait/idle are ongoing states: one pixel mascot per --id in the notch
# until `zzz clear` or expiry. info/ok/fail pop up briefly; ok/fail on a live
# --id make its mascot react, then leave unless an ongoing status follows.
# Exits 0 even if the app is not running, so hooks never break their caller.
# Works with macOS /bin/bash 3.2.
set -eu

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; }

urlencode() {
  local LC_ALL=C
  local s=$1 out= c i
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case $c in
      [a-zA-Z0-9.~_-]) out=$out$c ;;
      *) printf -v c '%d' "'$c"; printf -v c '%%%02X' $((c & 255)); out=$out$c ;;
    esac
  done
  printf '%s' "$out"
}

# zzz ask: one question, waits for the answer in the notch (see header).
ask_cmd() {
  local question= id= multiple= timeout=120 query= nopt=0 npos=0 url sock raw
  while [ $# -gt 0 ]; do
    case $1 in
      --id|--timeout)
        [ $# -ge 2 ] || { echo "zzz: $1 needs a value" >&2; exit 2; }
        if [ "$1" = --id ]; then id=$2; else timeout=$2; fi
        shift 2 ;;
      --option)
        [ $# -ge 2 ] || { echo "zzz: --option needs a value" >&2; exit 2; }
        query="$query&option=$(urlencode "$2")"; nopt=$((nopt + 1)); shift 2 ;;
      --multiple) multiple=1; shift ;;
      -h|--help) usage; exit 0 ;;
      -*) echo "zzz: unknown option $1" >&2; exit 2 ;;
      *)
        [ $npos -eq 0 ] || { echo "zzz: too many arguments" >&2; exit 2; }
        question=$1; npos=1; shift ;;
    esac
  done
  [ -n "$id" ] || { echo "zzz: ask needs --id" >&2; exit 2; }
  [ -n "$question" ] || { echo "zzz: ask needs a question" >&2; exit 2; }
  [ "$nopt" -ge 1 ] && [ "$nopt" -le 6 ] || { echo "zzz: ask needs 1-6 --option" >&2; exit 2; }
  case $timeout in ''|*[!0-9]*) echo "zzz: --timeout must be seconds" >&2; exit 2 ;; esac

  url="zzznotch://ask?id=$(urlencode "$id")&question=$(urlencode "$question")$query&timeout=$timeout${multiple:+&multiple=1}"
  if [ -n "${ZZZ_DRY_RUN:-}" ]; then printf '%s\n' "$url"; exit 0; fi

  # The app replies with one line: chosen options joined by \x1f, empty on timeout.
  sock=/tmp/zzznotch-$(id -u).sock
  [ -S "$sock" ] || exit 1
  raw=$(printf '%s\n' "$url" | nc -U "$sock" 2>/dev/null) || exit 1
  [ -n "$raw" ] || exit 1
  printf '%s\n' "$raw" | tr '\037' '\n'
  exit 0
}

case ${1:-} in
  notify|clear) action=$1; shift ;;
  ask) shift; ask_cmd "$@" ;;
  -h|--help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

title= body= status= source= symbol= app= url= id= duration= detail= activity= agents= prompt= now= intent= command= step= agentlist= npos=0
while [ $# -gt 0 ]; do
  case $1 in
    --status|--source|--symbol|--app|--url|--id|--duration|--detail|--activity|--agents|--prompt|--now|--intent|--command|--step)
      [ $# -ge 2 ] || { echo "zzz: $1 needs a value" >&2; exit 2; }
      eval "${1#--}=\$2"; shift 2 ;;
    --agent-list)
      [ $# -ge 2 ] || { echo "zzz: $1 needs a value" >&2; exit 2; }
      agentlist=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "zzz: unknown option $1" >&2; exit 2 ;;
    *)
      case $npos in
        0) title=$1 ;;
        1) body=$1 ;;
        *) echo "zzz: too many arguments" >&2; exit 2 ;;
      esac
      npos=$((npos + 1)); shift ;;
  esac
done

if [ "$action" = clear ]; then
  [ -n "$id" ] || { echo "zzz: clear needs --id" >&2; exit 2; }
else
  [ -n "$title$body" ] || { echo "zzz: title or body required" >&2; exit 2; }
fi

query=
for key in title body status source symbol app url id duration detail activity agents prompt now intent command step agentlist; do
  eval "value=\$$key"
  [ -n "$value" ] || continue
  if [ "$key" = agentlist ]; then name=agentList; else name=$key; fi
  query="$query${query:+&}$name=$(urlencode "$value")"
done

if [ -n "${ZZZ_DRY_RUN:-}" ]; then
  printf 'zzznotch://%s?%s\n' "$action" "$query"
  exit 0
fi
open -g "zzznotch://$action?$query" 2>/dev/null || true
